<Window x:Class="Blueipooth.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blueipooth" Width="1100" Height="760" MinWidth="900" MinHeight="600"
        Icon="pack://application:,,,/app.ico"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid>
        <!-- Main Layout -->
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Custom Bluetooth + Music Note App Icon Mark -->
                    <Border Width="40" Height="40" CornerRadius="11" Background="#161D2C" BorderBrush="#457DD3FC" BorderThickness="1.2"
                            Margin="0,0,13,0" VerticalAlignment="Center">
                        <Canvas Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Bluetooth Rune (#7DD3FC) -->
                            <Path Data="M 4.5 8.5 L 12.5 16.5 L 8.5 21 L 8.5 4 L 12.5 8.5 L 4.5 16.5"
                                  Stroke="#7DD3FC" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <!-- Musical Note (#A8C7FA) -->
                            <Path Data="M 19.5 17.5 L 19.5 6.5 L 23.5 8.8"
                                  Stroke="#A8C7FA" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <Ellipse Canvas.Left="15" Canvas.Top="15" Width="5.6" Height="4.6" Fill="#A8C7FA"/>
                        </Canvas>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Cyberpunk / Futuristic Stylized Wordmark matching icon palette -->
                            <TextBlock FontFamily="Bahnschrift, Consolas, Segoe UI" FontSize="23" FontWeight="Bold" VerticalAlignment="Center">
                                <Run Text="BLUE" Foreground="#7DD3FC"/><Run Text="IP" Foreground="#C4B5FD"/><Run Text="OOTH" Foreground="#A8C7FA"/>
                            </TextBlock>
                            <Border Background="#1F7DD3FC" BorderBrush="#407DD3FC" BorderThickness="1" CornerRadius="5" Padding="6,1.5" Margin="9,2,0,0" VerticalAlignment="Center">
                                <TextBlock Text="BT 5.2 // AUDIO" FontFamily="Consolas" FontSize="9.5" FontWeight="Bold" Foreground="#7DD3FC"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Cầu nối Bluetooth &amp; Âm thanh độ trễ thấp giữa Điện thoại và PC"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border x:Name="BadgeTopConn" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="12,5" Margin="18,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotTopConn" Width="8" Height="8" Fill="#FDE68A" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtTopConnBadge" Text="Chờ kết nối điện thoại" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnSettings" Content="⚙ Cài đặt" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                            ToolTip="Cài đặt giao diện và cách thoát cửa sổ" Click="OnOpenSettingsClick"/>
                    <Button Content="Ẩn xuống khay" Style="{StaticResource SecondaryButtonStyle}" Click="OnMinimizeToTrayClick"/>
                </StackPanel>
            </Grid>

            <!-- Center 2-Column Area: Left Function Sub-Tabs + Right Active Tab Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="248"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Panel: Sub-Tabs + Compact Adapter Status -->
                <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,0,16,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Danh mục" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="8,2,0,10"/>

                        <StackPanel Grid.Row="1">
                            <RadioButton x:Name="TabConnect" Content="🔗  Kết nối thiết bị" Style="{StaticResource NavTabRadioStyle}"
                                         IsChecked="True" Checked="OnNavTabChanged"/>
                            <RadioButton x:Name="TabAudio" Content="🎧  Phát âm thanh" Style="{StaticResource NavTabRadioStyle}"
                                         Checked="OnNavTabChanged"/>
                            <RadioButton x:Name="TabBluetooth" Content="📡  Quét Bluetooth" Style="{StaticResource NavTabRadioStyle}"
                                         Checked="OnNavTabChanged"/>
                        </StackPanel>

                        <!-- Compact Virtual Adapter Status at bottom of left sidebar -->
                        <Border Grid.Row="2" Background="{DynamicResource SubCardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Hệ thống PC" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                                <DockPanel Margin="0,0,0,5">
                                    <TextBlock DockPanel.Dock="Right" x:Name="TxtDriverStatus" Text="Đang kiểm tra..." FontSize="11.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="Driver" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,5">
                                    <TextBlock DockPanel.Dock="Right" x:Name="TxtCableStatus" Text="Đang kiểm tra..." FontSize="11.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="Mic ảo" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,5">
                                    <TextBlock DockPanel.Dock="Right" x:Name="TxtAdapterStatus" Text="Chưa bật" FontSize="11.5" FontWeight="SemiBold" Foreground="#FDE68A"/>
                                    <TextBlock Text="Adapter" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" x:Name="TxtHciCounters" Text="0 Cmd / 0 Evt" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="HCI" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Right Panel: Active Tab Content -->
                <Grid Grid.Column="1" x:Name="TabContentHost">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="TabContentSlide" X="0" Y="0"/>
                    </Grid.RenderTransform>

                    <!-- TAB 1 (DEFAULT): KẾT NỐI QR & TRẠNG THÁI -->
                    <Grid x:Name="PanelConnect" Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- QR Pairing Card -->
                        <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="18" Padding="24" Margin="0,0,14,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Ghép nối thiết bị" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock x:Name="TxtPhoneStatus" Text="Mở Blueipooth trên điện thoại rồi quét mã"
                                               FontSize="18.5" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="TxtCandidateIps" Text="Đang tìm địa chỉ mạng..."
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <Viewbox Grid.Row="1" MaxWidth="228" MaxHeight="228" Margin="0,12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Background="White" CornerRadius="16" Width="228" Height="228" Padding="10">
                                        <Image x:Name="ImgQrCode" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                    </Border>
                                </Viewbox>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Làm mới mã QR" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="OnRefreshQrClick"/>
                                    <Button x:Name="BtnPauseConnection" Content="Tạm ngừng kết nối" Style="{StaticResource SecondaryButtonStyle}" Click="OnToggleConnectionPauseClick"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Device & Session Telemetry Card (Padding inside ScrollViewer prevents top clipping on window resize!) -->
                        <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="18" Padding="0" ClipToBounds="True">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="20,18,20,18">
                                    <TextBlock Text="Thiết bị &amp; đường truyền" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="Tổng quan kết nối" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,12"/>

                                    <!-- Kênh phát & Độ trễ thực tế -->
                                    <Border Background="{DynamicResource SubCardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1" CornerRadius="15" Padding="14,12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Kênh đang phát &amp; độ trễ" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                                            <TextBlock x:Name="TxtQrRouteChannel" Text="Chờ kết nối..." FontSize="13.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentCyanBrush}" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="TxtQrAudioLatency" Text="Độ trễ thực tế: --" FontSize="12" FontWeight="Medium"
                                                       Foreground="#86EFAC" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Trạng thái điện thoại -->
                                    <Border Background="{DynamicResource SubCardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1" CornerRadius="15" Padding="14,12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Điện thoại Android" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock DockPanel.Dock="Right" x:Name="TxtPhoneBattery" Text="--" FontWeight="SemiBold" FontSize="12.5"/>
                                                <TextBlock Text="Mức pin" Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock DockPanel.Dock="Right" x:Name="TxtPhoneBtState" Text="--" FontWeight="SemiBold" FontSize="12.5"/>
                                                <TextBlock Text="Bluetooth điện thoại" Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5"/>
                                            </DockPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <TextBlock DockPanel.Dock="Right" x:Name="TxtConnectedBtNames" Text="Không có" FontWeight="SemiBold" FontSize="12.5"
                                                           Foreground="#86EFAC" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                                <TextBlock Text="Bluetooth đã nối" Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5"/>
                                            </DockPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" x:Name="TxtPhoneAudioDevice" Text="Chưa kết nối" FontWeight="SemiBold" FontSize="12.5"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                                <TextBlock Text="Đầu ra âm thanh" Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5"/>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Media đang phát (iOS Frosted Glass & NectarLink Expandable Card) -->
                                    <Border Background="#202736" BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1" CornerRadius="22">
                                        <Grid>
                                            <!-- Nền mờ bo góc chuẩn 21px bằng ImageBrush trên Border (không bao giờ bị tràn 4 góc vuông!) -->
                                            <Border CornerRadius="21" Opacity="0.22" IsHitTestVisible="False">
                                                <Border.Background>
                                                    <ImageBrush x:Name="BrushMediaBackdrop" Stretch="UniformToFill"/>
                                                </Border.Background>
                                            </Border>
                                            <Border CornerRadius="21" Background="#48121622" IsHitTestVisible="False"/>

                                            <StackPanel Margin="15,13,15,11">
                                                <!-- Hàng 1: 3 thanh sóng nhạc + Pill [Phone | PC] (không có icon nhỏ) + Tên App + Độ trễ + Nút Mở rộng (⌄/⌃) -->
                                                <DockPanel Margin="0,0,0,11">
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Background="#28FFFFFF" CornerRadius="9" Padding="8,2.5" VerticalAlignment="Center" Margin="0,0,4,0">
                                                            <TextBlock x:Name="TxtMediaCardLatency" Text="-- ms" FontSize="11" FontWeight="SemiBold" Foreground="#A8C7FA"/>
                                                        </Border>
                                                        <Button x:Name="BtnMediaExpand" Width="26" Height="26" Style="{StaticResource MediaIconBtnStyle}"
                                                                ToolTip="Mở rộng / Thu gọn điều khiển âm lượng &amp; tua" Click="OnToggleMediaExpandClick">
                                                            <Path x:Name="PathMediaExpandChevron" Data="M 4 7 L 9 12 L 14 7"
                                                                  Width="18" Height="18" Stroke="#B8C2D8" StrokeThickness="1.6"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                        </Button>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <!-- 3 thanh sóng nhạc mềm -->
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0" Height="13">
                                                            <Border x:Name="EqBar1" Width="2.5" Height="4" Background="#A8C7FA" CornerRadius="1.25" VerticalAlignment="Bottom" Margin="0,0,2,0"/>
                                                            <Border x:Name="EqBar2" Width="2.5" Height="4" Background="#A8C7FA" CornerRadius="1.25" VerticalAlignment="Bottom" Margin="0,0,2,0"/>
                                                            <Border x:Name="EqBar3" Width="2.5" Height="4" Background="#A8C7FA" CornerRadius="1.25" VerticalAlignment="Bottom"/>
                                                        </StackPanel>

                                                        <!-- Pill chuyển đổi [Phone | PC] tối giản (đã bỏ icon nhỏ cạnh chữ) -->
                                                        <Border Background="#22FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="11" Padding="2" Margin="0,0,8,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border x:Name="PillMediaPhone" Background="#A8C7FA" CornerRadius="9" Padding="10,2.5" Cursor="Hand"
                                                                        MouseLeftButtonDown="OnSelectPhoneMediaSource">
                                                                    <TextBlock x:Name="TxtLabelPhone" Text="Phone" FontSize="11" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <Border x:Name="PillMediaPc" Background="Transparent" CornerRadius="9" Padding="10,2.5" Cursor="Hand"
                                                                        MouseLeftButtonDown="OnSelectPcMediaSource">
                                                                    <TextBlock x:Name="TxtLabelPc" Text="PC" FontSize="11" FontWeight="SemiBold" Foreground="#98A3B8" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </StackPanel>
                                                        </Border>

                                                        <TextBlock x:Name="TxtPcMediaSourceApp" Text="YouTube" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="#93C5FD" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="90"/>
                                                    </StackPanel>
                                                </DockPanel>

                                                <!-- Hàng 2: Ảnh bìa bo góc + Tên bài/Ca sĩ + Nút điều khiển thanh mảnh (khi ở chế độ Compact) -->
                                                <Grid Margin="0,0,0,11">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border x:Name="BdMediaCover" Grid.Column="0" Width="48" Height="48" CornerRadius="11" Background="#283144">
                                                        <Grid>
                                                            <Path Data="M 11 16 L 11 7 L 18 5 L 18 14" Stroke="#8A96AE" StrokeThickness="1.6"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Border x:Name="BdMediaThumbClip" CornerRadius="11">
                                                                <Border.Background>
                                                                    <ImageBrush x:Name="BrushMediaThumb" Stretch="UniformToFill"/>
                                                                </Border.Background>
                                                            </Border>
                                                        </Grid>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0">
                                                        <TextBlock x:Name="TxtPcMediaNow" Text="Chưa có media đang phát" FontSize="13.5" FontWeight="SemiBold"
                                                                   Foreground="#F1F5F9" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock x:Name="TxtPcMediaArtist" Text="Mở nhạc trên điện thoại hoặc PC" FontSize="12"
                                                                   Foreground="#A3ADC2" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                    </StackPanel>

                                                    <!-- Cụm nút Vector thanh mảnh ở chế độ Compact -->
                                                    <StackPanel x:Name="PanelMediaCompactControls" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Width="30" Height="30" Style="{StaticResource MediaIconBtnStyle}" ToolTip="Bài trước" Click="OnMediaPrevClick">
                                                            <Path Data="M 5.5 5.5 L 5.5 14.5 M 14.5 5.5 L 7.5 10 L 14.5 14.5 Z" Width="20" Height="20"
                                                                  Stroke="#C8D2E6" StrokeThickness="1.45" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                        </Button>
                                                        <Border Width="36" Height="36" CornerRadius="18" Background="#2CFFFFFF" Margin="3,0">
                                                            <Button x:Name="BtnMediaPlayPause" Width="36" Height="36" Style="{StaticResource MediaIconBtnStyle}"
                                                                    ToolTip="Phát / Tạm dừng" Click="OnMediaPlayPauseClick">
                                                                <Path x:Name="PathPlayPauseCompact" Data="M 8.5 6 L 16.5 11 L 8.5 16 Z" Width="22" Height="22"
                                                                      Stroke="#F1F5F9" StrokeThickness="1.55" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                            </Button>
                                                        </Border>
                                                        <Button Width="30" Height="30" Style="{StaticResource MediaIconBtnStyle}" ToolTip="Bài tiếp theo" Click="OnMediaNextClick">
                                                            <Path Data="M 5.5 5.5 L 12.5 10 L 5.5 14.5 Z M 14.5 5.5 L 14.5 14.5" Width="20" Height="20"
                                                                  Stroke="#C8D2E6" StrokeThickness="1.45" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Hàng 3: Thanh kéo tua trực tiếp (Interactive Seek Slider) + Thời gian -->
                                                <Slider x:Name="SldMediaTimeline" Minimum="0" Maximum="100" Value="0"
                                                        Style="{StaticResource MediaSeekSliderStyle}"
                                                        PreviewMouseLeftButtonDown="OnTimelineSeekStart"
                                                        PreviewMouseLeftButtonUp="OnTimelineSeekCommit"
                                                        ValueChanged="OnTimelineSliderValueChanged"/>
                                                <DockPanel Margin="0,1,0,0">
                                                    <TextBlock DockPanel.Dock="Right" x:Name="TxtPcMediaRemaining" Text="-0:00" FontSize="11"
                                                               Foreground="#A3ADC2"/>
                                                    <TextBlock x:Name="TxtPcMediaElapsed" Text="0:00" FontSize="11"
                                                               Foreground="#A3ADC2"/>
                                                </DockPanel>

                                                <!-- Hàng Mở rộng (Expanded Controls: -10s, Prev, Play/Pause, Next, +10s + Thanh Âm lượng PC/Phone) -->
                                                <StackPanel x:Name="PanelMediaExpanded" Visibility="Collapsed" Margin="0,8,0,2">
                                                    <!-- 5 nút điều khiển thanh mảnh ở giữa giống NectarLink -->
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                                        <!-- Tua lùi 10s -->
                                                        <Button Width="34" Height="34" Style="{StaticResource MediaIconBtnStyle}" Margin="0,0,8,0"
                                                                ToolTip="Tua lùi 10 giây" Click="OnMediaSeekBack10Click">
                                                            <Path Data="M 11 4.5 L 7.5 7 L 11 9.5 M 8.5 7 A 6.2 6.2 0 1 1 5.2 12.5" Width="22" Height="22"
                                                                  Stroke="#C8D2E6" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                        </Button>
                                                        <!-- Bài trước -->
                                                        <Button Width="34" Height="34" Style="{StaticResource MediaIconBtnStyle}" Margin="0,0,10,0"
                                                                ToolTip="Bài trước" Click="OnMediaPrevClick">
                                                            <Path Data="M 5.5 5.5 L 5.5 16.5 M 16.5 5.5 L 8 11 L 16.5 16.5 Z" Width="22" Height="22"
                                                                  Stroke="#D8E0F0" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                        </Button>
                                                        <!-- Nút tròn Play / Pause lớn -->
                                                        <Border Width="44" Height="44" CornerRadius="22" Background="#2EFFFFFF" Margin="0,0,10,0">
                                                            <Button Width="44" Height="44" Style="{StaticResource MediaIconBtnStyle}"
                                                                    ToolTip="Phát / Tạm dừng" Click="OnMediaPlayPauseClick">
                                                                <Path x:Name="PathPlayPauseExpanded" Data="M 9.5 6.5 L 18.5 12 L 9.5 17.5 Z" Width="24" Height="24"
                                                                      Stroke="#F8FAFC" StrokeThickness="1.65" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                            </Button>
                                                        </Border>
                                                        <!-- Bài tiếp theo -->
                                                        <Button Width="34" Height="34" Style="{StaticResource MediaIconBtnStyle}" Margin="0,0,8,0"
                                                                ToolTip="Bài tiếp theo" Click="OnMediaNextClick">
                                                            <Path Data="M 5.5 5.5 L 14 11 L 5.5 16.5 Z M 16.5 5.5 L 16.5 16.5" Width="22" Height="22"
                                                                  Stroke="#D8E0F0" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                        </Button>
                                                        <!-- Tua tới 10s -->
                                                        <Button Width="34" Height="34" Style="{StaticResource MediaIconBtnStyle}"
                                                                ToolTip="Tua tới 10 giây" Click="OnMediaSeekForward10Click">
                                                            <Path Data="M 11 4.5 L 14.5 7 L 11 9.5 M 13.5 7 A 6.2 6.2 0 1 0 16.8 12.5" Width="22" Height="22"
                                                                  Stroke="#C8D2E6" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                        </Button>
                                                    </StackPanel>

                                                    <!-- Thanh điều chỉnh âm lượng PC / Phone -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button Grid.Column="0" Width="28" Height="28" Style="{StaticResource MediaIconBtnStyle}"
                                                                ToolTip="Tắt / Bật tiếng" Click="OnMediaMuteClick">
                                                            <Path x:Name="PathMediaVolumeIcon" Data="M 4 8.5 H 7 L 11 5 V 15 L 7 11.5 H 4 Z M 14 7.5 A 3.5 3.5 0 0 1 14 12.5"
                                                                  Width="20" Height="20" Stroke="#B8C2D8" StrokeThickness="1.45"
                                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                                        </Button>
                                                        <Slider x:Name="SldMediaVolume" Grid.Column="1" Minimum="0" Maximum="100" Value="70"
                                                                Margin="8,0,10,0" VerticalAlignment="Center"
                                                                Style="{StaticResource MediaSeekSliderStyle}"
                                                                ValueChanged="OnMediaVolumeChanged"/>
                                                        <Border Grid.Column="2" Background="#24FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1"
                                                                CornerRadius="11" Padding="9,3.5" VerticalAlignment="Center">
                                                            <TextBlock x:Name="TxtMediaVolumeTarget" Text="🔊 PC speaker" FontSize="11" FontWeight="SemiBold" Foreground="#DCE2EE"/>
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>

                                                <!-- Hàng 4: 2 chấm chỉ trang (Phone / PC) ở chính giữa -->
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                                                    <Border x:Name="DotMediaPhone" Width="14" Height="4.5" CornerRadius="2.25" Background="#A8C7FA"
                                                            Margin="0,0,5,0" Cursor="Hand" MouseLeftButtonDown="OnSelectPhoneMediaSource"/>
                                                    <Border x:Name="DotMediaPc" Width="4.5" Height="4.5" CornerRadius="2.25" Background="#5A6478"
                                                            Cursor="Hand" MouseLeftButtonDown="OnSelectPcMediaSource"/>
                                                </StackPanel>

                                                <TextBlock x:Name="TxtPhoneMediaNow" Visibility="Collapsed"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- TAB 2: PHÁT ÂM THANH (REDESIGNED) -->
                    <Border x:Name="PanelAudio" Visibility="Collapsed"
                            Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="24">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,14">
                                    <Border DockPanel.Dock="Right" Background="{DynamicResource SubCardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                            BorderThickness="1" CornerRadius="10" Padding="12,6" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtAudioLatency" Text="Chờ kết nối" Foreground="{DynamicResource AccentCyanBrush}"
                                                   FontWeight="SemiBold" FontSize="12"/>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="PHÁT ÂM THANH &amp; MIC" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}"/>
                                        <TextBlock x:Name="TxtHeadsetName" Text="Loa / Tai nghe trên Điện thoại" FontSize="20" FontWeight="Bold"
                                                   Foreground="#4ADE80" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock x:Name="TxtDualMac" Visibility="Collapsed"/>

                                <!-- Hình thức phát (2 sleek cards) -->
                                <TextBlock Text="Chọn hình thức phát âm thanh" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="RbGamingMode" Grid.Column="0"
                                                 Content="Phát trực tiếp qua Mạng / USB"
                                                 Tag="Truyền thẳng âm thanh stereo 48kHz từ PC sang điện thoại &amp; tai nghe"
                                                 Style="{StaticResource ModeCardRadioStyle}"
                                                 IsChecked="True" Checked="OnAudioModeChanged"/>
                                    <RadioButton x:Name="RbNativeA2dpMode" Grid.Column="2"
                                                 Content="Bluetooth Windows (Card ảo)"
                                                 Tag="Phát qua adapter Bluetooth 5.2 ảo trong cài đặt Windows"
                                                 Style="{StaticResource ModeCardRadioStyle}"
                                                 Checked="OnAudioModeChanged"/>
                                </Grid>

                                <!-- Microphone & Bộ đệm -->
                                <Border Background="{DynamicResource SubCardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Microphone &amp; Bộ đệm" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox x:Name="ChkMicBridge" Grid.Column="0" Content="Truyền mic từ điện thoại về PC"
                                                      Style="{StaticResource ToggleSwitchCheckBoxStyle}" IsChecked="False"
                                                      Checked="OnAudioModeChanged" Unchecked="OnAudioModeChanged"/>
                                            <CheckBox x:Name="ChkMicNoiseFilter" Grid.Column="1" Content="Lọc ồn mic tự động"
                                                      Style="{StaticResource ToggleSwitchCheckBoxStyle}" IsChecked="True"
                                                      Checked="OnNoiseFilterChanged" Unchecked="OnNoiseFilterChanged"/>
                                        </Grid>

                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock DockPanel.Dock="Right" x:Name="TxtBufferVal" Text="20 ms" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold"/>
                                            <TextBlock Text="Đệm ổn định âm thanh (Jitter Buffer)" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </DockPanel>
                                        <Slider x:Name="SldJitterBuffer" Minimum="10" Maximum="80" Value="20"
                                                Style="{StaticResource ModernSliderStyle}" ValueChanged="OnJitterSliderChanged"/>
                                    </StackPanel>
                                </Border>

                                <!-- Mức tín hiệu thời gian thực (Mềm mại, bo tròn pill, chuyển động mượt không giật) -->
                                <Border Background="{DynamicResource SubCardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="16" Padding="18,16">
                                    <StackPanel>
                                        <TextBlock Text="Mức tín hiệu thời gian thực" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock DockPanel.Dock="Right" x:Name="TxtSpeakerMeterPct" Text="0%" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" FontWeight="Medium"/>
                                            <TextBlock Text="Loa PC → Điện thoại" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                                        </DockPanel>
                                        <Border Height="10" CornerRadius="5" Background="#161B26" Margin="0,0,0,14" ClipToBounds="True">
                                            <Border Height="10" CornerRadius="5" Background="#7DD3FC" RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform x:Name="ScaleSpeakerMeter" ScaleX="0" ScaleY="1"/>
                                                </Border.RenderTransform>
                                            </Border>
                                        </Border>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBlock DockPanel.Dock="Right" x:Name="TxtMicMeterPct" Text="0%" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" FontWeight="Medium"/>
                                            <TextBlock Text="Mic Điện thoại → PC" Foreground="{DynamicResource TextMutedBrush}" FontSize="12"/>
                                        </DockPanel>
                                        <Border Height="10" CornerRadius="5" Background="#161B26" ClipToBounds="True">
                                            <Border Height="10" CornerRadius="5" Background="#86EFAC" RenderTransformOrigin="0,0.5">
                                                <Border.RenderTransform>
                                                    <ScaleTransform x:Name="ScaleMicMeter" ScaleX="0" ScaleY="1"/>
                                                </Border.RenderTransform>
                                            </Border>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- TAB 3: BLUETOOTH ẢO & QUÉT BLUETOOTH -->
                    <Grid x:Name="PanelBluetooth" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Card Bluetooth 5.2 Ảo + Nút Bluetooth Windows -->
                        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Text="BLUETOOTH ẢO TRÊN PC" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}"/>
                                    <TextBlock Text="Card Bluetooth 5.2 Ảo (BthUsb.sys)" FontSize="16" FontWeight="Bold" Margin="0,3,0,2"/>
                                    <TextBlock Text="Tạo adapter Bluetooth ảo trên Windows để kết nối qua Bluetooth Windows (cài sẵn driver &amp; VB-CABLE)."
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="BtnToggleVirtualBt" Content="Bật Card Bluetooth Ảo"
                                                Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,0" Click="OnToggleVirtualBtClick"/>
                                        <Button Content="Bluetooth Windows" Style="{StaticResource SecondaryButtonStyle}" Click="OnOpenBtSettingsClick"/>
                                    </StackPanel>
                                    <Button x:Name="BtnInstallDriver" Content="Tự cài thành phần còn thiếu"
                                            Style="{StaticResource SecondaryButtonStyle}" Margin="0,8,0,0"
                                            HorizontalAlignment="Right" Click="OnInstallDriverClick"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Quét BLE 2.4GHz -->
                        <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="QUÉT BLUETOOTH (BLE 2.4GHZ)" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}"/>
                                        <TextBlock x:Name="TxtBleScanStatus" Text="Sẵn sàng — nhấn Quét để yêu cầu điện thoại quét thiết bị xung quanh"
                                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox x:Name="ChkHideUnnamedBle" Content="Ẩn không tên / chỉ quảng bá"
                                                  Foreground="{DynamicResource TextMutedBrush}" IsChecked="True"
                                                  VerticalAlignment="Center" Margin="0,0,12,0"
                                                  Checked="OnBleFilterChanged" Unchecked="OnBleFilterChanged"/>
                                        <Button x:Name="BtnScanBle" Content="Quét Bluetooth" Style="{StaticResource PrimaryButtonStyle}"
                                                Margin="0,0,8,0" Click="OnToggleBleScanClick"/>
                                        <Button Content="Xóa danh sách" Style="{StaticResource SecondaryButtonStyle}" Click="OnClearBleListClick"/>
                                    </StackPanel>
                                </Grid>

                                <ProgressBar x:Name="PbBleScanning" Grid.Row="1" IsIndeterminate="True" Height="4" Margin="0,10,0,4"
                                             Foreground="{DynamicResource AccentCyanBrush}" Background="{DynamicResource SubCardBgBrush}"
                                             BorderThickness="0" Visibility="Collapsed"/>

                                <Border Grid.Row="2" Background="{DynamicResource SubCardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,8,0,0">
                                    <Grid>
                                        <TextBlock x:Name="TxtBleEmptyHint"
                                                   Text="Chưa có thiết bị Bluetooth nào được phát hiện. Hãy kết nối điện thoại và bấm Quét Bluetooth."
                                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="13"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                        <ListBox x:Name="LstBleDevices" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderThickness="0" FontSize="12.5" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                                            BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="2,3">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"/>
                                                                <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextMutedBrush}"
                                                                           FontFamily="Consolas" FontSize="11.5" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                            <Border Grid.Column="1" Background="{DynamicResource SubCardBgBrush}" CornerRadius="6"
                                                                    Padding="10,4" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding RssiText}" Foreground="{Binding RssiBrush}"
                                                                           FontFamily="Consolas" FontWeight="Bold" FontSize="12"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Bottom Log Panel (Shared across all tabs) -->
            <Border Grid.Row="2" Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,14,0,0">
                <Expander x:Name="ExpLogs" Header="Nhật ký hoạt động (Log)" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold">
                    <Grid Height="125" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="TxtLogs" Background="{DynamicResource SubCardBgBrush}" Foreground="{DynamicResource TextMutedBrush}"
                                 BorderThickness="0" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap" FontFamily="Consolas" FontSize="11.5" Padding="8"/>
                        <Button Content="Xóa log" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" FontSize="11"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,22,0" Click="OnClearLogsClick"/>
                    </Grid>
                </Expander>
            </Border>
        </Grid>

        <!-- Settings Modal Popup Overlay -->
        <Grid x:Name="SettingsOverlay" Visibility="Collapsed" Background="#99000000" MouseDown="OnSettingsBackdropMouseDown">
            <Border x:Name="SettingsModalCard" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="16" Width="460" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseDown="OnSettingsCardMouseDown">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="SettingsModalScale" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <Button DockPanel.Dock="Right" Content="✕" Width="32" Height="32" Padding="0"
                                Style="{StaticResource SecondaryButtonStyle}" Click="OnCloseSettingsClick"/>
                        <StackPanel>
                            <TextBlock Text="Cài đặt Blueipooth" FontSize="19" FontWeight="Bold"/>
                            <TextBlock Text="Tùy chỉnh giao diện và hành vi đóng cửa sổ" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Appearance Section -->
                    <Border Background="{DynamicResource SubCardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Giao diện ứng dụng" FontWeight="Bold" FontSize="13.5" Margin="0,0,0,10"/>
                            <RadioButton x:Name="RbThemeMidnight" Content="Tối mặc định (Midnight Slate)"
                                         Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" Checked="OnSettingChanged"/>
                            <RadioButton x:Name="RbThemeOcean" Content="Xanh thẫm (Deep Ocean)"
                                         Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" Checked="OnSettingChanged"/>
                            <RadioButton x:Name="RbThemeLight" Content="Sáng (Light Mode)"
                                         Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" Checked="OnSettingChanged"/>
                            <CheckBox x:Name="ChkExpandLogsDefault" Content="Mở rộng khung Nhật ký (Log) mặc định"
                                      Foreground="{DynamicResource TextPrimaryBrush}" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- Close Window Behavior Section -->
                    <Border Background="{DynamicResource SubCardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Cách thoát cửa sổ (khi bấm nút X)" FontWeight="Bold" FontSize="13.5" Margin="0,0,0,10"/>
                            <RadioButton x:Name="RbCloseTray" Content="Thoát xuống khay hệ thống (chạy ngầm)"
                                         Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" Checked="OnSettingChanged"/>
                            <RadioButton x:Name="RbCloseExit" Content="Thoát hẳn ứng dụng và tháo Bluetooth ảo"
                                         Foreground="{DynamicResource TextPrimaryBrush}" Checked="OnSettingChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- Actions -->
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Content="Thoát hẳn ngay" Style="{StaticResource DangerButtonStyle}"
                                Click="OnExitApplicationClick"/>
                        <Button DockPanel.Dock="Right" Content="Xong" Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Right" MinWidth="96" Click="OnCloseSettingsClick"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
