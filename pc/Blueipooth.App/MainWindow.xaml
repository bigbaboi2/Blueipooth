<Window x:Class="Blueipooth.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blueipooth" Width="1100" Height="760" MinWidth="920" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid>
        <!-- Main Layout -->
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Header Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Blueipooth" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}"/>
                        <TextBlock Text="Cầu nối Bluetooth &amp; Âm thanh độ trễ thấp giữa Điện thoại và PC"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border x:Name="BadgeTopConn" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="12,5" Margin="18,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotTopConn" Width="8" Height="8" Fill="#FBBF24" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtTopConnBadge" Text="Chờ kết nối điện thoại" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Bluetooth Windows" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="OnOpenBtSettingsClick"/>
                    <Button x:Name="BtnSettings" Content="⚙ Cài đặt" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"
                            ToolTip="Cài đặt giao diện và cách thoát cửa sổ" Click="OnOpenSettingsClick"/>
                    <Button Content="Ẩn xuống khay" Style="{StaticResource SecondaryButtonStyle}" Click="OnMinimizeToTrayClick"/>
                </StackPanel>
            </Grid>

            <!-- Center 2-Column Area: Left Function Sub-Tabs + Right Active Tab Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="248"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Panel: Sub-Tabs + Compact Adapter Status -->
                <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,16,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="CHỨC NĂNG" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="6,2,0,10"/>

                        <StackPanel Grid.Row="1">
                            <RadioButton x:Name="TabConnect" Content="🔗  Kết nối QR" Style="{StaticResource NavTabRadioStyle}"
                                         IsChecked="True" Checked="OnNavTabChanged"/>
                            <RadioButton x:Name="TabBluetooth" Content="📡  Quét Bluetooth" Style="{StaticResource NavTabRadioStyle}"
                                         Checked="OnNavTabChanged"/>
                            <RadioButton x:Name="TabAudio" Content="🎧  Phát âm thanh" Style="{StaticResource NavTabRadioStyle}"
                                         Checked="OnNavTabChanged"/>
                        </StackPanel>

                        <!-- Compact Virtual Adapter Status at bottom of left sidebar -->
                        <Border Grid.Row="2" Background="{DynamicResource SubCardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="TRẠNG THÁI PC" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" Margin="0,0,0,8"/>
                                <DockPanel Margin="0,0,0,5">
                                    <TextBlock DockPanel.Dock="Right" x:Name="TxtDriverStatus" Text="Đang kiểm tra..." FontSize="11.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="Driver" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,5">
                                    <TextBlock DockPanel.Dock="Right" x:Name="TxtCableStatus" Text="Đang kiểm tra..." FontSize="11.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="Mic ảo" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,5">
                                    <TextBlock DockPanel.Dock="Right" x:Name="TxtAdapterStatus" Text="Chưa bật" FontSize="11.5" FontWeight="Bold" Foreground="#FBBF24"/>
                                    <TextBlock Text="Adapter" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" x:Name="TxtHciCounters" Text="0 Cmd / 0 Evt" FontSize="11.5" Foreground="{DynamicResource AccentCyanBrush}"/>
                                    <TextBlock Text="HCI" FontSize="11.5" Foreground="{DynamicResource TextMutedBrush}"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Right Panel: Active Tab Content -->
                <Grid Grid.Column="1" x:Name="TabContentHost">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="TabContentSlide" X="0" Y="0"/>
                    </Grid.RenderTransform>

                    <!-- TAB 1 (DEFAULT): KẾT NỐI QR -->
                    <Grid x:Name="PanelConnect" Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- QR Pairing Card -->
                        <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="24" Margin="0,0,14,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock Text="KẾT NỐI ĐIỆN THOẠI (MẶC ĐỊNH)" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}"/>
                                    <TextBlock x:Name="TxtPhoneStatus" Text="Mở Blueipooth trên điện thoại rồi quét mã QR"
                                               FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="TxtCandidateIps" Text="Đang tìm địa chỉ mạng..."
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <Border Grid.Row="1" Background="White" CornerRadius="14" Width="232" Height="232" Padding="10"
                                        Margin="0,16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image x:Name="ImgQrCode" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Border>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Làm mới mã QR" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Click="OnRefreshQrClick"/>
                                    <Button x:Name="BtnPauseConnection" Content="Tạm ngừng kết nối" Style="{StaticResource SecondaryButtonStyle}" Click="OnToggleConnectionPauseClick"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Virtual Bluetooth Adapter Controls Card -->
                        <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="14" Padding="22">
                            <StackPanel>
                                <TextBlock Text="BLUETOOTH ẢO TRÊN PC" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}"/>
                                <TextBlock Text="Card Bluetooth 5.2 Ảo" FontSize="18" FontWeight="Bold" Margin="0,6,0,4"/>
                                <TextBlock Text="Tạo adapter Bluetooth ảo (BthUsb.sys) trên Windows để dùng điện thoại làm bộ thu phát."
                                           Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" FontSize="12.5" Margin="0,0,0,18"/>

                                <Button x:Name="BtnToggleVirtualBt" Content="Bật Card Bluetooth Ảo trên Windows"
                                        Style="{StaticResource PrimaryButtonStyle}" Click="OnToggleVirtualBtClick"/>
                                <Button x:Name="BtnInstallDriver" Content="Tự cài thành phần còn thiếu"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,10,0,0" Click="OnInstallDriverClick"/>

                                <Border Background="{DynamicResource SubCardBgBrush}" CornerRadius="10" Padding="12" Margin="0,16,0,0"
                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="Hướng dẫn nhanh" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,0,6"/>
                                        <TextBlock Text="1. Mở app Blueipooth trên Android (tab giữa)." Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                                        <TextBlock Text="2. Bấm Quét Mã QR và hướng camera vào mã bên trái." Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        <TextBlock Text="3. Sau khi nối, chuyển sang tab Quét Bluetooth hoặc Phát âm thanh." Foreground="{DynamicResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="VB-CABLE by VB-Audio (vb-cable.com) • donationware • cần quyền quản trị"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- TAB 2: QUÉT BLUETOOTH -->
                    <Border x:Name="PanelBluetooth" Visibility="Collapsed"
                            Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="24">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="QUÉT BLUETOOTH (BLE 2.4GHZ)" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}"/>
                                    <TextBlock Text="Gửi yêu cầu quét cho Android &amp; xem thiết bị khả dụng" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="TxtBleScanStatus" Text="Sẵn sàng — nhấn Quét để yêu cầu điện thoại quét thiết bị xung quanh"
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="12.5" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox x:Name="ChkHideUnnamedBle" Content="Ẩn không tên / chỉ quảng bá"
                                              Foreground="{DynamicResource TextMutedBrush}" IsChecked="True"
                                              VerticalAlignment="Center" Margin="0,0,12,0"
                                              Checked="OnBleFilterChanged" Unchecked="OnBleFilterChanged"/>
                                    <Button x:Name="BtnScanBle" Content="Quét Bluetooth" Style="{StaticResource PrimaryButtonStyle}"
                                            Margin="0,0,8,0" Click="OnToggleBleScanClick"/>
                                    <Button Content="Xóa danh sách" Style="{StaticResource SecondaryButtonStyle}" Click="OnClearBleListClick"/>
                                </StackPanel>
                            </Grid>

                            <ProgressBar x:Name="PbBleScanning" Grid.Row="1" IsIndeterminate="True" Height="4" Margin="0,12,0,4"
                                         Foreground="{DynamicResource AccentCyanBrush}" Background="{DynamicResource SubCardBgBrush}"
                                         BorderThickness="0" Visibility="Collapsed"/>

                            <Border Grid.Row="2" Background="{DynamicResource SubCardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,10,0,0">
                                <Grid>
                                    <TextBlock x:Name="TxtBleEmptyHint"
                                               Text="Chưa có thiết bị Bluetooth nào được phát hiện. Hãy kết nối điện thoại và bấm Quét Bluetooth."
                                               Foreground="{DynamicResource TextMutedBrush}" FontSize="13"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <ListBox x:Name="LstBleDevices" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderThickness="0" FontSize="12.5" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                                        BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="2,3">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"/>
                                                            <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextMutedBrush}"
                                                                       FontFamily="Consolas" FontSize="11.5" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="1" Background="{DynamicResource SubCardBgBrush}" CornerRadius="6"
                                                                Padding="10,4" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding RssiText}" Foreground="{Binding RssiBrush}"
                                                                       FontFamily="Consolas" FontWeight="Bold" FontSize="12"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- TAB 3: PHÁT ÂM THANH -->
                    <Border x:Name="PanelAudio" Visibility="Collapsed"
                            Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="24">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="PHÁT ÂM THANH &amp; MIC" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}"/>
                                <TextBlock x:Name="TxtHeadsetName" Text="Tai nghe trên điện thoại" FontSize="20" FontWeight="Bold"
                                           Foreground="#4ADE80" Margin="0,6,0,2"/>
                                <TextBlock x:Name="TxtAudioLatency" Text="Chờ kết nối điện thoại" Foreground="{DynamicResource AccentCyanBrush}" FontSize="13"/>
                                <TextBlock x:Name="TxtDualMac" Visibility="Collapsed"/>

                                <Border Background="{DynamicResource SubCardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,16,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Chế độ truyền âm thanh" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                        <RadioButton x:Name="RbGamingMode" Content="Âm thanh độ trễ thấp (Gaming Opus 48kHz)"
                                                     Foreground="{DynamicResource TextPrimaryBrush}" IsChecked="True" Margin="0,0,0,8" Checked="OnAudioModeChanged"/>
                                        <RadioButton x:Name="RbNativeA2dpMode" Content="Bluetooth Windows (A2DP chuẩn)"
                                                     Foreground="{DynamicResource TextPrimaryBrush}" Checked="OnAudioModeChanged"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource SubCardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Microphone &amp; Bộ đệm" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                        <CheckBox x:Name="ChkMicBridge" Content="Truyền mic từ điện thoại/tai nghe về PC"
                                                  Foreground="{DynamicResource TextPrimaryBrush}" IsChecked="False" Margin="0,0,0,8"
                                                  Checked="OnAudioModeChanged" Unchecked="OnAudioModeChanged"/>
                                        <CheckBox x:Name="ChkMicNoiseFilter" Content="Lọc ồn mic"
                                                  Foreground="{DynamicResource TextPrimaryBrush}" IsChecked="True" Margin="0,0,0,12"
                                                  Checked="OnNoiseFilterChanged" Unchecked="OnNoiseFilterChanged"/>

                                        <DockPanel Margin="0,0,0,4">
                                            <TextBlock DockPanel.Dock="Right" x:Name="TxtBufferVal" Text="30 ms" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold"/>
                                            <TextBlock Text="Đệm âm thanh (Jitter Buffer)" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </DockPanel>
                                        <Slider x:Name="SldJitterBuffer" Minimum="15" Maximum="80" Value="30" TickFrequency="5"
                                                IsSnapToTickEnabled="True" ValueChanged="OnJitterSliderChanged"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource SubCardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,12,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Mức tín hiệu thời gian thực" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                        <TextBlock Text="Loa PC -> Điện thoại" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4"/>
                                        <ProgressBar x:Name="PbSpeakerLevel" Minimum="0" Maximum="100" Height="8" Margin="0,0,0,10"
                                                     Foreground="#38BDF8" Background="{DynamicResource CardBgBrush}" BorderThickness="0"/>
                                        <TextBlock Text="Mic Điện thoại -> PC" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,4"/>
                                        <ProgressBar x:Name="PbMicLevel" Minimum="0" Maximum="100" Height="8"
                                                     Foreground="#4ADE80" Background="{DynamicResource CardBgBrush}" BorderThickness="0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- Bottom Log Panel (Shared across all tabs) -->
            <Border Grid.Row="2" Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,14,0,0">
                <Expander x:Name="ExpLogs" Header="Nhật ký hoạt động (Log)" Foreground="{DynamicResource TextMutedBrush}" FontWeight="SemiBold">
                    <Grid Height="125" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBox x:Name="TxtLogs" Background="{DynamicResource SubCardBgBrush}" Foreground="{DynamicResource TextMutedBrush}"
                                 BorderThickness="0" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap" FontFamily="Consolas" FontSize="11.5" Padding="8"/>
                        <Button Content="Xóa log" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" FontSize="11"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,22,0" Click="OnClearLogsClick"/>
                    </Grid>
                </Expander>
            </Border>
        </Grid>

        <!-- Settings Modal Popup Overlay -->
        <Grid x:Name="SettingsOverlay" Visibility="Collapsed" Background="#99000000" MouseDown="OnSettingsBackdropMouseDown">
            <Border x:Name="SettingsModalCard" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="16" Width="460" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MouseDown="OnSettingsCardMouseDown">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="SettingsModalScale" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <Button DockPanel.Dock="Right" Content="✕" Width="32" Height="32" Padding="0"
                                Style="{StaticResource SecondaryButtonStyle}" Click="OnCloseSettingsClick"/>
                        <StackPanel>
                            <TextBlock Text="Cài đặt Blueipooth" FontSize="19" FontWeight="Bold"/>
                            <TextBlock Text="Tùy chỉnh giao diện và hành vi đóng cửa sổ" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Appearance Section -->
                    <Border Background="{DynamicResource SubCardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Giao diện ứng dụng" FontWeight="Bold" FontSize="13.5" Margin="0,0,0,10"/>
                            <RadioButton x:Name="RbThemeMidnight" Content="Tối mặc định (Midnight Slate)"
                                         Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" Checked="OnSettingChanged"/>
                            <RadioButton x:Name="RbThemeOcean" Content="Xanh thẫm (Deep Ocean)"
                                         Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" Checked="OnSettingChanged"/>
                            <RadioButton x:Name="RbThemeLight" Content="Sáng (Light Mode)"
                                         Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" Checked="OnSettingChanged"/>
                            <CheckBox x:Name="ChkExpandLogsDefault" Content="Mở rộng khung Nhật ký (Log) mặc định"
                                      Foreground="{DynamicResource TextPrimaryBrush}" Checked="OnSettingChanged" Unchecked="OnSettingChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- Close Window Behavior Section -->
                    <Border Background="{DynamicResource SubCardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Cách thoát cửa sổ (khi bấm nút X)" FontWeight="Bold" FontSize="13.5" Margin="0,0,0,10"/>
                            <RadioButton x:Name="RbCloseTray" Content="Thoát xuống khay hệ thống (chạy ngầm)"
                                         Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" Checked="OnSettingChanged"/>
                            <RadioButton x:Name="RbCloseExit" Content="Thoát hẳn ứng dụng và tháo Bluetooth ảo"
                                         Foreground="{DynamicResource TextPrimaryBrush}" Checked="OnSettingChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- Actions -->
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Content="Thoát hẳn ngay" Style="{StaticResource DangerButtonStyle}"
                                Click="OnExitApplicationClick"/>
                        <Button DockPanel.Dock="Right" Content="Xong" Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Right" MinWidth="96" Click="OnCloseSettingsClick"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
